# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}
DB_DATABASE=${DB_DATABASE}

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=7d

# Mail Configuration
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USER=${MAIL_USER}
MAIL_PASSWORD=${MAIL_PASSWORD}

# Server Configuration
PORT=${PORT}
NODE_ENV=production 